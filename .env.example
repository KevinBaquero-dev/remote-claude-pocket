# Copy to ~/.config/remote-claude-pocket/.env and chmod 600 it.

# Token from @BotFather.
TELEGRAM_TOKEN=

# Your numeric Telegram user id (ask @userinfobot). Only this user is obeyed.
ALLOWED_USER_ID=

# Optional: Healthchecks.io ping URL (pinged every 5 minutes) and API key
# (used to pause the check before "shutdown server").
HC_PING_URL=
HC_API_KEY=
